# ===== SysRent Shop (เว็บขายแอปพรีเมียม) — คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้ามอัปขึ้น GitHub) =====
# ฐานข้อมูลเดียวกับ SysRent
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# โดเมนหลัก: ร้าน = <slug>.sysrent.shop · ตอนรันในเครื่องใช้ DEV_SHOP_SLUG แทน
SHOP_ROOT_DOMAIN=sysrent.shop
DEV_SHOP_SLUG=

# ===== ตรวจสลิป (ใช้ของ SysRent ร่วมกันทุกร้าน — ร้านไม่ต้องสมัครเอง) =====
# เลือกเจ้า: thunder | slipok (ไม่ใส่ = ใช้ Thunder ถ้ามีคีย์ ไม่งั้น SlipOK · ไม่มีทั้งคู่ = ตรวจเองด้วย QR + AI)
SLIP_PROVIDER=
# Thunder (https://developer.thunder.in.th) — ถ้าเปิด IP whitelist ไว้ ต้องใส่ IP เซิร์ฟเวอร์ในหน้า Thunder ด้วย
THUNDER_API_KEY=
# SlipOK
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# ตรวจเองเมื่อไม่มีบริการด้านบน: AI อ่านสลิป (ไม่บังคับ) · เติมจากสลิปอย่างเดียวได้ไม่เกิน SLIP_AUTO_MAX บาท
ANTHROPIC_API_KEY=
SLIP_AI_MODEL=
SLIP_AUTO_MAX=200

# กุญแจเข้ารหัสรหัสผ่านบัญชีหลักในคลังบัญชี (อย่างน้อย 32 ตัว · ห้ามเปลี่ยนหลังใช้งานจริง)
ENC_KEY=

# กุญแจลับให้ SysRent เรียก API ภายใน (สร้างร้านตอนลูกค้าเช่า) — ใส่ค่าเดียวกันในเว็บหลัก
SHOP_INTERNAL_KEY=

# ===== อีเมลแจ้งลูกค้า (ใส่ค่าจริงใน .env.local เท่านั้น) — ไม่ใส่ = ระบบไม่ส่งอีเมล แต่อย่างอื่นทำงานปกติ =====
# Gmail: SMTP_HOST=smtp.gmail.com · SMTP_PORT=587 · SMTP_USER=อีเมล · SMTP_PASS=App Password (ไม่ใช่รหัสผ่านปกติ)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudflare Turnstile (login/register). Set both to enforce; hostname: sysrent.shop
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public back-office path. Pick your own value (one segment), never /admin
NEXT_PUBLIC_ADMIN_PATH=
